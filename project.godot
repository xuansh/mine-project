; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mine-project"
run/main_scene="uid://0mwhc64nggdg"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

Game="*uid://djplay2ogwslm"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1152
window/size/window_height_override=648
window/hdr/request_hdr_output=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Assets/Fonts/": "red"
}

[gui]

; 像素字体渲染：关抗锯齿 / hinting / 亚像素定位，否则字形边缘会闪
theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0
theme/default_font_generate_mipmaps=false

[rendering]

; UI 落在半像素上会闪（非整数倍缩放时）：统一吸附到整数像素
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

